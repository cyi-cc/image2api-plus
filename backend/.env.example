# image2api backend config template. Copy to .env and fill in real values.
# Real environment variables override .env.

APP_ENV=development
APP_TITLE=image2api
HTTP_ADDR=:6666

# PostgreSQL (database must already exist; tables auto-migrate on boot)
POSTGRES_DSN=host=127.0.0.1 user=postgres password=YOUR_PASSWORD dbname=vivid_ai port=5432 sslmode=disable TimeZone=Asia/Shanghai

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# RustFS / S3-compatible object storage (generated media + reference uploads)
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_BUCKET=vivid-ai
RUSTFS_ACCESS_KEY=YOUR_AK
RUSTFS_SECRET_KEY=YOUR_SK

# Channel upstream API keys are stored AES-GCM encrypted with this secret.
# Set a random value in production and keep it stable — changing it makes
# previously saved channel keys undecryptable.
CHANNEL_SECRET=change-me-channel-secret

# Frontend dev origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when serving the site over HTTPS (session cookie Secure flag)
COOKIE_SECURE=false

# SESSION_COOKIE_NAME=vivid_session
# GENERATED_ROOT=   # optional: override generated media root
